# 复制为 .env 后填入自己的 Tushare Pro token；.env 已被 .gitignore 忽略
TUSHARE_TOKEN=your_token_here
# 官方地址；若使用自建/第三方网关，在此改成自己的地址（不要提交到仓库）
TUSHARE_URL=https://api.tushare.pro
# 可选：Netlify 站点 Deploy Hook；配置后每次更新会自动重建 dist 并发布
NETLIFY_DEPLOY_HOOK=
# 自动发布到 GitHub Pages（git push 触发 Actions 重建）
AUTO_PUBLISH=1
# 用于 git push 的 token（需 repo 权限）；留空则回退系统钥匙串
GITHUB_TOKEN=
GITHUB_USER=

# 推送目标（空格分隔）：private=Cloudflare 源仓；origin=旧 GitHub Pages
# 例：PUBLISH_REMOTES=private origin
PUBLISH_REMOTES=private
